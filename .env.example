# ------------------------------------------------------------------
# FindMe environment variables
# Copy this file to .env for local development, or set the values in
# the Render dashboard for production. Every value below is a
# placeholder - never commit real credentials.
# ------------------------------------------------------------------

# Flask session secret - REQUIRED in production (any long random string,
# e.g. generate one with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-string

# Production flag (Render also auto-detects via its RENDER env var)
FINDME_ENV=production

# --- MySQL database ---
# Local XAMPP defaults (work with NO configuration): localhost / root / findme_db
# Aiven for MySQL (production): host = <service>.aivencloud.com, user = avnadmin,
# password = the service password, database = defaultdb
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=findme_db

# SSL CA certificate - REQUIRED for Aiven, leave commented out for local XAMPP.
# Download the Aiven CA certificate and save it as ca.pem in the project root
# (see ca.pem.README), then uncomment:
# MYSQL_SSL_CA=ca.pem

# --- Cloudinary image storage ---
# Optional locally: when unset, images are saved to static/uploads as before.
# In production (Render's disk is ephemeral) set all three.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Legacy aliases (still supported) ---
# DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME, DB_SSL_CA
# DATABASE_URL=mysql://user:pass@host:3306/db
