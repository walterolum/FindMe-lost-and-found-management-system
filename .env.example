# FindMe - Environment Variables
# Copy to .env and fill for local or hosting
SECRET_KEY=change-me-to-a-random-32-char-string
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=findme_db
# Optional: single URL overrides the above (Render/Railway/Heroku)
# DATABASE_URL=mysql://user:pass@host:3306/findme_db
# For hosting, also set:
# MYSQL_URL=mysql://user:pass@host:3306/findme_db
PORT=5000
FLASK_ENV=production
